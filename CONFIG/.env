# ============================================================================
# Kolrose Limited - Environment Configuration
# Suite 10, Bataiya Plaza, Area 2 Garki, Opposite FCDA, Abuja, FCT, Nigeria
# ============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ============================================================================
# OPENROUTER API CONFIGURATION (Required)
# ============================================================================
# Get a free API key at https://openrouter.ai/keys
# Free tier: 50 requests/day (no purchase), 1000 requests/day (with $10 purchase)
OPENROUTER_API_KEY=sk-or-v1-your-api-key-here

# OpenRouter base URL (do not change)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ============================================================================
# LLM MODEL SELECTION
# ============================================================================
# Free models available on OpenRouter:
#   google/gemini-2.0-flash-001    - Google Gemini Flash (recommended, fast)
#   meta-llama/llama-3.1-8b-instruct:free - Meta Llama 3.1
#   mistralai/mistral-7b-instruct:free    - Mistral 7B
#   openai/gpt-3.5-turbo           - OpenAI GPT-3.5 (may need credits)
LLM_MODEL=google/gemini-2.0-flash-001

# ============================================================================
# EMBEDDING MODEL CONFIGURATION
# ============================================================================
# Local embedding model (free, runs on your machine)
# Options:
#   sentence-transformers/all-MiniLM-L6-v2  - Small (80MB), fast, 384 dimensions
#   sentence-transformers/all-mpnet-base-v2 - Better quality, 420MB, 768 dimensions
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Device for embedding model: cpu or cuda (GPU)
EMBEDDING_DEVICE=cpu

# ============================================================================
# VECTOR DATABASE CONFIGURATION
# ============================================================================
# Path to persist ChromaDB vector store
CHROMA_PATH=./chroma_db

# Collection name for ChromaDB
CHROMA_COLLECTION_NAME=kolrose_policies_v2

# ============================================================================
# POLICY DOCUMENTS PATH
# ============================================================================
# Directory containing policy markdown files
POLICIES_PATH=./policies

# ============================================================================
# RAG CONFIGURATION
# ============================================================================
# Chunk size for document splitting (characters)
CHUNK_SIZE=500

# Overlap between chunks (characters)
CHUNK_OVERLAP=100

# Number of initial candidates to retrieve
RETRIEVAL_K=20

# Number of final results after re-ranking
FINAL_K=5

# Maximum tokens for LLM output
MAX_OUTPUT_TOKENS=500

# Maximum characters in final response
MAX_RESPONSE_CHARS=2000

# ============================================================================
# GUARDRAIL CONFIGURATION
# ============================================================================
# Enable/disable all guardrails
ENABLE_GUARDRAILS=true

# Enable sensitive topic detection
SENSITIVE_TOPICS_ENABLED=true

# Require citations in all responses
CITATION_REQUIRED=true

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================
# Environment: development or production
APP_ENV=development

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Streamlit server port
STREAMLIT_PORT=8501

# ============================================================================
# COMPANY INFORMATION
# ============================================================================
COMPANY_NAME=Kolrose Limited
COMPANY_ADDRESS=Suite 10, Bataiya Plaza, Area 2 Garki, Opposite FCDA, Abuja, FCT, Nigeria
COMPANY_WEBSITE=https://kolroselimited.com.ng
COMPANY_EMAIL_HR=hr@kolroselimited.com.ng
COMPANY_EMAIL_COMPLIANCE=compliance@kolroselimited.com.ng
COMPANY_EMAIL_SECURITY=security@kolroselimited.com.ng
COMPANY_HOTLINE_WHISTLEBLOWER=0800-KOLROSE
COMPANY_HOTLINE_IT_SECURITY=0800-KOL-ITSEC

# ============================================================================
# STREAMLIT CLOUD SECRETS (for deployment)
# ============================================================================
# When deploying to Streamlit Cloud, set these in the Secrets Manager:
# OPENROUTER_API_KEY = "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"
# LLM_MODEL = "google/gemini-2.0-flash-001"